# ⚡ TIMEBROKER.AI — SERVERLESS ENVIRONMENT VARIABLES
# Copy this file to .env or set these in GCP Secret Manager/Firebase Config

# ─────────────────────────────────────────────────────────────
# 📋 GOOGLE STACK / FIREBASE
# ─────────────────────────────────────────────────────────────
# Set this to the project ID (default: ac-godmode-titan)
GCLOUD_PROJECT=ac-godmode-titan
# Set this to the Vertex AI region (default: us-central1)
VERTEX_AI_LOCATION=us-central1

# ─────────────────────────────────────────────────────────────
# 💾 LEAD STORAGE & NOTIFICATION (Part 5 Placeholders)
# ─────────────────────────────────────────────────────────────
# Google Sheet Spreadsheet ID to append lead rows (e.g. from Sheets URL)
# Example URL: https://docs.google.com/spreadsheets/d/1XyZ.../edit
# Sheet ID: 1XyZ...
STORAGE_SHEET_ID=your-google-sheet-id-here

# Email address where lead alerts and call-prep briefs are dispatched
NOTIFY_EMAIL=delray@timebroker.ai

# ─────────────────────────────────────────────────────────────
# ✉️ DUAL-PATH EMAIL PROVIDER (Optional, fallbacks to Firestore mail queue)
# ─────────────────────────────────────────────────────────────
# Resend API Key for sending emails directly (begins with re_)
RESEND_API_KEY=
# SendGrid API Key for sending emails directly (begins with SG.)
SENDGRID_API_KEY=
# Email sender address (e.g., no-reply@timebroker.ai)
EMAIL_FROM=Timebroker.ai <no-reply@timebroker.ai>
