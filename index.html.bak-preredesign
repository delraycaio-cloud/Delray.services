        async function callOmniConcierge(prompt, context) {
            try {
                if (!window._firebase) {
                    await new Promise(resolve => window.addEventListener('firebase-ready', resolve, { once: true }));
                }
                const { functions, httpsCallable } = window._firebase;
                const omni = httpsCallable(functions, 'omniConciergeV1');
                const result = await omni({ message: prompt, persona: 'ORACLE', context: context || 'delray-consulting' });
                return result.data?.response || result.data?.message || null;
            } catch (err) {
                console.warn('Omni-Concierge error:', err.message);
                return null;
            }
        }

